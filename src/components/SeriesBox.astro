---
import type { SeriesNavData } from '../utils/series';
import { normalizeSlug } from '../utils/posts';

interface Props {
  nav: SeriesNavData;
  isFooter?: boolean;
}

const { nav, isFooter = false } = Astro.props;
---

<section
  class={`border-2 border-border-brutal bg-surface p-5 shadow-constructivist-sm ${
    isFooter ? 'my-6' : 'my-8'
  }`}
  aria-label={`Série ${nav.seriesName}`}
>
  <!-- Cabeçalho Construtivista da Série -->
  <div class="flex flex-wrap items-center justify-between gap-3 border-b border-border-brutal/20 pb-3 mb-4">
    <div class="flex flex-wrap items-center gap-2">
      <span class="bg-manifesto-red text-white font-mono text-xs font-black px-2.5 py-1 uppercase tracking-wider shadow-xs">
        // SÉRIE ESPECIAL: {nav.seriesName}
      </span>
      <span class="font-mono text-xs text-ink-muted font-bold">
        [{nav.currentIndex} DE {nav.totalCount}]
      </span>
    </div>

    <a
      href={`/series/${nav.seriesSlug}`}
      class="font-mono text-xs font-bold text-manifesto-red hover:underline tracking-tight"
    >
      [VER SÉRIE COMPLETA &rarr;]
    </a>
  </div>

  <p class="font-mono text-xs text-ink-muted mb-4">
    Texto <strong class="text-ink">{nav.currentIndex}</strong> de <strong class="text-ink">{nav.totalCount}</strong> publicado nesta série.
  </p>

  <!-- Navegação Anterior / Próximo na Série -->
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 my-4 font-mono text-xs">
    {nav.prevPost ? (
      <a
        href={`/post/${normalizeSlug(nav.prevPost.data.slug || nav.prevPost.slug)}`}
        class="press-btn border border-border-brutal bg-canvas p-3 flex flex-col justify-between hover:border-manifesto-red shadow-xs transition-colors"
      >
        <span class="text-manifesto-red font-bold mb-1">&larr; TEXTO ANTERIOR NA SÉRIE</span>
        <span class="font-display font-bold text-sm text-ink line-clamp-1">
          {nav.prevPost.data.title}
        </span>
      </a>
    ) : (
      <div class="border border-dashed border-border-brutal/30 p-3 text-ink-muted/60 flex items-center">
        <span>&bull; Este é o primeiro texto da série</span>
      </div>
    )}

    {nav.nextPost ? (
      <a
        href={`/post/${normalizeSlug(nav.nextPost.data.slug || nav.nextPost.slug)}`}
        class="press-btn border border-border-brutal bg-canvas p-3 flex flex-col justify-between text-right hover:border-manifesto-red shadow-xs transition-colors"
      >
        <span class="text-manifesto-red font-bold mb-1">PRÓXIMO TEXTO NA SÉRIE &rarr;</span>
        <span class="font-display font-bold text-sm text-ink line-clamp-1">
          {nav.nextPost.data.title}
        </span>
      </a>
    ) : (
      <div class="border border-dashed border-border-brutal/30 p-3 text-ink-muted/60 flex items-center justify-end">
        <span>&bull; Último texto publicado desta série</span>
      </div>
    )}
  </div>

  <!-- Sumário Sanfona com todos os textos da série (apenas no cabeçalho) -->
  {!isFooter && nav.allSeriesPosts && nav.allSeriesPosts.length > 1 && (
    <details class="mt-4 pt-3 border-t border-border-brutal/20 font-mono text-xs group">
      <summary class="cursor-pointer font-bold text-ink hover:text-manifesto-red select-none flex items-center justify-between">
        <span>ÍNDICE COMPLETO DESTA SÉRIE ({nav.totalCount} TEXTOS) [Expandir ↓ ↓ ↓]</span>
        <span class="text-manifesto-red group-open:rotate-180 transition-transform">&darr;</span>
      </summary>
      <ol class="mt-3 space-y-2 pl-4 list-decimal marker:text-manifesto-red marker:font-bold">
        {nav.allSeriesPosts.map((p, idx) => {
          const isCurrent = idx + 1 === nav.currentIndex;
          const pSlug = normalizeSlug(p.data.slug || p.slug);
          return (
            <li class={isCurrent ? 'font-bold text-manifesto-red' : 'text-ink'}>
              {isCurrent ? (
                <span>
                  {p.data.title} <span class="text-xs font-normal text-ink-muted">[Lendo agora]</span>
                </span>
              ) : (
                <a href={`/post/${pSlug}`} class="hover:underline hover:text-manifesto-red">
                  {p.data.title}
                </a>
              )}
            </li>
          );
        })}
      </ol>
    </details>
  )}
</section>

