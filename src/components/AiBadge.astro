---
// AiBadge.astro: Selo Construtivista de Transparência de IA (0RWX) com Pop-up Explicativo
import { AI_CATEGORIES, getAiCategory } from '../data/ai';

interface Props {
  level?: string;
  aiUse?: string;
}

const { level = 'AI:0', aiUse } = Astro.props;
const activeCategory = getAiCategory(level);
---

<div class="inline-flex items-center" data-pagefind-ignore>
  <button
    type="button"
    data-ai-modal-open
    class="press-btn inline-flex items-center gap-2 border-2 border-border-brutal bg-canvas text-ink hover:border-manifesto-red hover:text-manifesto-red font-mono text-xs font-bold px-2.5 py-1 uppercase tracking-wider shadow-constructivist-sm transition-colors cursor-pointer"
    title={`Classificação de IA: ${activeCategory.label} (${activeCategory.code}) — Clique para entender`}
    aria-haspopup="dialog"
  >
    <img
      src={activeCategory.icon}
      alt={activeCategory.code}
      class="w-5 h-5 object-contain invert dark:invert-0"
      loading="lazy"
    />
    <span>{activeCategory.label}</span>
    <span class="bg-border-brutal text-canvas dark:bg-surface dark:text-ink px-1.5 py-0.2 text-[11px] font-black">
      {activeCategory.code}
    </span>
    {aiUse && (
      <span class="hidden sm:inline text-[10px] text-ink-muted font-normal lowercase">
        [ver uso]
      </span>
    )}
    <span class="text-manifesto-red font-black text-xs" aria-hidden="true">[?]</span>
  </button>

  <dialog
    data-ai-modal
    aria-labelledby="ai-modal-title"
    class="backdrop:bg-black/75 bg-transparent p-0 m-auto max-w-3xl w-[95vw] sm:w-[92vw] text-ink open:animate-fade-in"
  >
    <div class="border-2 sm:border-3 border-border-brutal bg-surface shadow-constructivist-double cut-corner-br max-h-[85dvh] sm:max-h-[88vh] overflow-y-auto custom-scrollbar flex flex-col">
      
      <!-- Cabeçalho do Pop-up (Fixo no topo durante a rolagem no mobile) -->
      <div class="sticky top-0 z-20 bg-surface flex items-center justify-between gap-2.5 sm:gap-4 border-b-2 border-border-brutal px-3.5 py-3 sm:px-6 sm:py-4">
        <div class="flex items-center gap-2.5 sm:gap-3.5 min-w-0">
          <img
            src={activeCategory.icon}
            alt={activeCategory.code}
            class="w-8 h-8 sm:w-11 sm:h-11 object-contain shrink-0 invert dark:invert-0"
          />
          <div class="min-w-0">
            <div class="font-mono text-[10px] sm:text-xs font-bold text-manifesto-red uppercase tracking-wider sm:tracking-widest truncate">
              // PROTOCOLO 0RWX
            </div>
            <h2 id="ai-modal-title" class="font-display font-black text-sm sm:text-2xl uppercase tracking-tight text-ink leading-tight">
              CLASSIFICAÇÃO DE USO DE IA: <span class="text-manifesto-red">{activeCategory.label} ({activeCategory.code})</span>
            </h2>
          </div>
        </div>

        <button
          type="button"
          data-ai-modal-close
          class="press-btn shrink-0 border-2 border-border-brutal bg-canvas text-ink hover:bg-manifesto-red hover:text-white font-mono text-xs font-bold px-2.5 py-1 sm:px-3 sm:py-1.5 uppercase shadow-constructivist-sm cursor-pointer"
          aria-label="Fechar janela explicativa"
        >
          <span class="sm:hidden">[ &#10005; ]</span>
          <span class="hidden sm:inline">[ FECHAR &#10005; ]</span>
        </button>
      </div>

      <!-- Corpo Rolável do Modal -->
      <div class="p-3.5 sm:p-6 space-y-4 sm:space-y-6">
        <!-- Declaração Específica da Postagem (aiUse) -->
        {aiUse && (
          <div class="border-2 border-manifesto-red bg-canvas p-3 sm:p-4 shadow-constructivist-sm">
            <div class="font-mono text-[11px] sm:text-xs font-black uppercase tracking-wider text-manifesto-red mb-1.5 flex items-center gap-1.5">
              <span>&#9733; DECLARAÇÃO NESTA PUBLICAÇÃO ({activeCategory.code}):</span>
            </div>
            <p class="font-serif text-sm sm:text-base text-ink leading-relaxed italic">
              "{aiUse}"
            </p>
          </div>
        )}

        <!-- Grade das 4 Categorias 0RWX (Categoria atual aparece primeiro no mobile) -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4">
          {AI_CATEGORIES.map((cat) => {
            const isCurrent = cat.code === activeCategory.code;
            return (
              <div
                class={`relative border-2 p-3 sm:p-4 transition-all flex flex-col justify-between ${
                  isCurrent
                    ? 'order-first sm:order-none border-manifesto-red bg-canvas shadow-constructivist-sm sm:shadow-constructivist-md'
                    : 'border-border-brutal/50 bg-surface/60 opacity-85 hover:opacity-100'
                }`}
              >
                <div>
                  <!-- Topo do Card da Categoria com Ícone Oficial -->
                  <div class="flex flex-wrap items-center justify-between gap-2 mb-2.5 pb-2 border-b border-border-brutal/20">
                    <div class="font-mono font-black text-xs sm:text-base uppercase flex items-center gap-2">
                      <img
                        src={cat.icon}
                        alt={cat.code}
                        class="w-7 h-7 sm:w-8 sm:h-8 object-contain shrink-0 invert dark:invert-0"
                        loading="lazy"
                      />
                      <span class={isCurrent ? 'text-manifesto-red' : 'text-ink'}>
                        {cat.label}
                      </span>
                      <span class={`px-1.5 py-0.5 text-[11px] sm:text-xs ${
                        isCurrent
                          ? 'bg-manifesto-red text-white'
                          : 'bg-border-brutal text-canvas dark:bg-canvas dark:text-ink'
                      }`}>
                        {cat.code}
                      </span>
                    </div>

                    {isCurrent && (
                      <span class="bg-manifesto-red text-white font-mono text-[9px] sm:text-[10px] font-black px-1.5 py-0.5 uppercase tracking-wider">
                        &#9733; NESTA PUBLICAÇÃO
                      </span>
                    )}
                  </div>

                  <!-- Permissão (estilo Unix) -->
                  <p class="font-mono text-[11px] sm:text-xs text-ink font-bold mb-0.5">
                    {cat.permissionPt}
                  </p>
                  <p class="font-mono text-[10px] sm:text-[11px] text-ink-muted mb-2.5">
                    ({cat.permissionEn})
                  </p>

                  <!-- Lema ("Eu penso" / "I think") -->
                  <div class="my-2 pl-2.5 sm:pl-3 border-l-3 border-manifesto-red">
                    <span class="font-display font-extrabold text-sm sm:text-base text-ink">
                      {cat.mottoPt}
                    </span>
                    <span class="font-mono text-[11px] sm:text-xs text-ink-muted ml-1">
                      / {cat.mottoEn}
                    </span>
                  </div>
                </div>

                <!-- Tag de Autoria -->
                <div class="mt-2.5 pt-2 border-t border-border-brutal/20 font-mono text-[11px] sm:text-xs">
                  <span class="font-black text-manifesto-red uppercase">
                    [{cat.tagEn} // {cat.tagPt}]
                  </span>
                </div>
              </div>
            );
          })}
        </div>

        <!-- Rodapé do Modal com Referência ao 0rwx.com -->
        <div class="pt-3 sm:pt-4 border-t-2 border-border-brutal flex flex-col sm:flex-row sm:items-center justify-between gap-2.5 font-mono text-[11px] sm:text-xs text-ink-muted">
          <span>
            Taxonomia inspirada nas permissões Unix (<code class="bg-canvas px-1 border border-border-brutal/40">0 / R / W / X</code>). Se omitido, assume-se <strong class="text-ink">AI:0</strong>.
          </span>
          <a
            href="https://0rwx.com/"
            target="_blank"
            rel="noopener noreferrer"
            class="font-bold text-manifesto-red hover:underline uppercase shrink-0"
          >
            [ BASEADO EM 0RWX.COM &nearr; ]
          </a>
        </div>
      </div>
    </div>
  </dialog>
</div>

<script>
  function setupAiBadgeModal() {
    const containers = document.querySelectorAll('[data-ai-modal-open]');
    containers.forEach((btn) => {
      const wrapper = btn.closest('div');
      const dialog = wrapper?.querySelector<HTMLDialogElement>('dialog[data-ai-modal]');
      const closeBtn = dialog?.querySelector<HTMLButtonElement>('[data-ai-modal-close]');

      if (!dialog) return;

      const unlockScroll = () => {
        document.body.style.overflow = '';
      };

      btn.addEventListener('click', () => {
        document.body.style.overflow = 'hidden';
        if (typeof dialog.showModal === 'function') {
          dialog.showModal();
        } else {
          dialog.setAttribute('open', '');
        }
      });

      closeBtn?.addEventListener('click', () => {
        unlockScroll();
        if (typeof dialog.close === 'function') {
          dialog.close();
        } else {
          dialog.removeAttribute('open');
        }
      });

      dialog.addEventListener('close', unlockScroll);

      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) {
          unlockScroll();
          dialog.close();
        }
      });
    });
  }

  setupAiBadgeModal();
  document.addEventListener('astro:page-load', setupAiBadgeModal);
</script>
