---
// Header.astro: Cabeçalho Construtivista com Emblema I_G e Menu Mobile Retrátil
import ThemeToggle from './ThemeToggle.astro';

const pathname = new URL(Astro.request.url).pathname;
const currentPath = pathname.replace(/\/$/, "") || "/";
const isPost = currentPath.startsWith('/post') || currentPath.startsWith('/p');

const navItems = [
  { href: "/", label: "INÍCIO", code: "01" },
  { href: "/arquivo", label: "ARQUIVO", code: "02" },
  { href: "/sobre", label: "SOBRE", code: "03" },
  { href: "/busca", label: "BUSCA", code: "04" },
];

const socialLinks = [
  { href: "/rss.xml", label: "RSS", title: "Feed RSS Oficial" },
  { href: "https://github.com/infoguerrilla", label: "GIT", title: "GitHub" },
  { href: "https://bsky.app/profile/infoguerrilla.bsky.social", label: "BSKY", title: "BlueSky" },
  { href: "https://twitter.com/infoguerrilla", label: "X", title: "Twitter / X" },
];
---

<header class="w-full border-b-2 border-border-brutal bg-canvas/95 backdrop-blur-sm sticky top-0 z-40">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between py-3 sm:py-4 gap-4">
      
      <!-- Marca Principal: Emblema I_G + Logotipo -->
      <div class="flex items-center gap-2 sm:gap-3 min-w-0">
        <!-- Emblema I_G (I e G brancos, _ preto, máquina de escrever pesada) -->
        <a href="/" aria-label="Info_Guerrilla Início" class="group block select-none shrink-0">
          <div class="flex items-center justify-center bg-manifesto-red border-2 border-border-brutal px-2 sm:px-2.5 py-1 shadow-constructivist-sm transform group-hover:-rotate-2 transition-transform">
            <span class="font-mono font-black text-lg sm:text-2xl tracking-tighter leading-none inline-flex items-center">
              <span class="text-white">I</span><span class="text-black font-extrabold -mx-0.5">_</span><span class="text-white">G</span>
            </span>
          </div>
        </a>

        <!-- Título e Lema Editorial (sem citação de Marx) -->
        <div class="min-w-0">
          <a href="/" class="group block">
            <span class="font-display font-black text-base xs:text-lg sm:text-2xl md:text-3xl tracking-tight text-ink uppercase group-hover:text-manifesto-red transition-colors block leading-tight truncate">
              INFO<span class="text-manifesto-red">_</span>GUERRILLA
            </span>
          </a>
          <p class="font-serif italic text-[11px] sm:text-sm text-ink-muted leading-tight hidden sm:block truncate">
            &ldquo;Para que o trabalho do alfaiate não desapareça na roupa&rdquo;
          </p>
        </div>
      </div>

      <!-- Ações do Cabeçalho: Redes, Tema & Botão Hambúrguer Mobile -->
      <div class="flex items-center gap-2 sm:gap-3 shrink-0">
        <!-- Redes Sociais e RSS (Desktop) -->
        <div class="hidden lg:flex items-center gap-1 font-mono text-[11px] font-bold">
          {socialLinks.map((s) => (
            <a
              href={s.href}
              target={s.href.startsWith("http") ? "_blank" : undefined}
              rel={s.href.startsWith("http") ? "noopener noreferrer" : undefined}
              title={s.title}
              class="press-btn border border-border-brutal/40 bg-surface px-2 py-1 text-ink hover:border-manifesto-red hover:bg-manifesto-red hover:text-white transition-colors"
            >
              [{s.label}]
            </a>
          ))}
        </div>

        <!-- Alternador de Tema (Desktop / Tablet md+) -->
        <div class="hidden md:flex items-center">
          <ThemeToggle id="desktop-theme-toggle" />
        </div>

        <!-- Botão Hambúrguer Tátil (Mobile) -->
        <button
          id="mobile-menu-toggle"
          type="button"
          aria-label="Abrir menu de navegação"
          aria-expanded="false"
          class="md:hidden press-btn flex items-center gap-1.5 border-2 border-border-brutal bg-surface px-2.5 py-1.5 font-mono text-xs font-bold uppercase text-ink shadow-constructivist-sm hover:border-manifesto-red focus:outline-none"
        >
          <span class="text-manifesto-red font-black">☰</span>
          <span id="mobile-menu-text">MENU</span>
        </button>
      </div>
    </div>

    <!-- Navegação Desktop (Escondida no Mobile) -->
    <nav class="hidden md:flex items-center justify-between border-t border-border-brutal/20 py-2 text-xs sm:text-sm font-mono tracking-wider">
      <div class="flex items-center gap-1.5 sm:gap-2 overflow-x-auto">
        {navItems.map((item) => {
          const isActive = currentPath === item.href || (item.href !== "/" && currentPath.startsWith(item.href));
          return (
            <a
              href={item.href}
              class={`press-btn px-2.5 sm:px-3 py-1 border transition-all select-none ${
                isActive
                  ? "border-border-brutal bg-manifesto-red text-white font-bold shadow-constructivist-sm"
                  : "border-transparent text-ink hover:border-border-brutal hover:bg-surface"
              }`}
            >
              <span class="text-[10px] opacity-75 mr-1 font-mono">[{item.code}]</span>
              {item.label}
            </a>
          );
        })}
      </div>

      <div class="text-[11px] font-mono text-ink-muted italic hidden xl:block">
        TEORIA CRÍTICA & VANGUARDA EDITORIAL
      </div>
    </nav>

    <!-- Painel Colapsável do Menu Mobile -->
    <div
      id="mobile-menu-panel"
      class="hidden md:hidden border-t-2 border-border-brutal py-4 space-y-3 bg-canvas"
    >
      <div class="grid grid-cols-2 gap-2">
        {navItems.map((item) => {
          const isActive = currentPath === item.href || (item.href !== "/" && currentPath.startsWith(item.href));
          return (
            <a
              href={item.href}
              class={`press-btn block text-center py-2 px-3 border font-mono text-xs font-bold uppercase ${
                isActive
                  ? "border-border-brutal bg-manifesto-red text-white shadow-constructivist-sm"
                  : "border-border-brutal bg-surface text-ink hover:border-manifesto-red"
              }`}
            >
              [{item.code}] {item.label}
            </a>
          );
        })}
      </div>

      <!-- Alternador de Modo Papel / Noturno (Mobile dentro do Hambúrguer para dar mais espaço no topo) -->
      <div class="pt-3 border-t border-border-brutal/20 flex items-center justify-between">
        <span class="font-mono text-xs font-bold text-ink-muted uppercase">// MODO VISUAL:</span>
        <ThemeToggle id="mobile-theme-toggle" />
      </div>

      <!-- Links Sociais no Mobile -->
      <div class="pt-3 border-t border-border-brutal/20 flex flex-wrap items-center justify-between gap-1.5 font-mono text-xs">
        <span class="text-ink-muted text-[11px] font-bold">// CANAIS:</span>
        <div class="flex flex-wrap gap-1">
          {socialLinks.map((s) => (
            <a
              href={s.href}
              target={s.href.startsWith("http") ? "_blank" : undefined}
              rel={s.href.startsWith("http") ? "noopener noreferrer" : undefined}
              class="border border-border-brutal bg-surface px-2 py-0.5 text-ink hover:bg-manifesto-red hover:text-white"
            >
              {s.label}
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>

  <!-- Régua de Progresso de Leitura Embutida na Própria Borda Inferior do Header (Exclusiva para Posts) -->
  <div
    id="header-reading-ruler"
    aria-hidden="true"
    class={`${isPost ? '' : 'hidden '}w-full h-[3px] bg-border-brutal/20 relative overflow-visible`}
  >
    <div
      id="header-reading-progress"
      class="h-full bg-manifesto-red transition-all duration-75 relative"
      style="width: 0%;"
    >
      <!-- Indicador Numérico Monospaçado de Precisão Construtivista -->
      <span
        id="header-reading-pct"
        class="hidden absolute top-1 right-0 translate-x-1/2 font-mono text-[9px] font-bold text-white bg-manifesto-red px-1 py-0.5 border border-border-brutal shadow-constructivist-sm"
      >
        [00%]
      </span>
    </div>
  </div>
</header>

<script>
  let activeReadingScrollListener: (() => void) | null = null;

  function setupReadingProgress() {
    if (activeReadingScrollListener) {
      window.removeEventListener('scroll', activeReadingScrollListener);
      window.removeEventListener('resize', activeReadingScrollListener);
      activeReadingScrollListener = null;
    }

    const rulerContainer = document.getElementById('header-reading-ruler');
    const progressEl = document.getElementById('header-reading-progress');
    const pctEl = document.getElementById('header-reading-pct');
    if (!rulerContainer || !progressEl) return;

    // A régua só deve funcionar e ser exibida em posts
    const article = document.querySelector('article[data-pagefind-body]');
    if (!article) {
      rulerContainer.classList.add('hidden');
      progressEl.style.width = '0%';
      if (pctEl) pctEl.classList.add('hidden');
      return;
    }

    // Exibe o container da régua se estiver em página de artigo
    rulerContainer.classList.remove('hidden');

    activeReadingScrollListener = () => {
      const rect = article.getBoundingClientRect();
      const articleTop = rect.top + window.scrollY;
      const articleHeight = rect.height;
      const windowHeight = window.innerHeight;
      const scrollPos = window.scrollY;

      const start = articleTop - 80;
      const end = articleTop + articleHeight - windowHeight;
      const distance = end - start;

      let progress = 0;
      if (distance <= 0) {
        progress = scrollPos >= start ? 100 : 0;
      } else {
        progress = Math.min(100, Math.max(0, ((scrollPos - start) / distance) * 100));
      }

      progressEl.style.width = `${progress}%`;
      if (pctEl) {
        if (progress > 0) {
          pctEl.classList.remove('hidden');
          pctEl.textContent = `[${Math.round(progress).toString().padStart(2, '0')}%]`;
        } else {
          pctEl.classList.add('hidden');
        }
      }
    };

    window.addEventListener('scroll', activeReadingScrollListener, { passive: true });
    window.addEventListener('resize', activeReadingScrollListener, { passive: true });
    activeReadingScrollListener();
  }

  function setupMobileMenu() {
    const toggleBtn = document.getElementById('mobile-menu-toggle');
    const panel = document.getElementById('mobile-menu-panel');
    const textEl = document.getElementById('mobile-menu-text');

    if (!toggleBtn || !panel) return;

    toggleBtn.onclick = () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', String(!isExpanded));
      panel.classList.toggle('hidden');
      if (textEl) {
        textEl.textContent = isExpanded ? 'MENU' : 'FECHAR';
      }
    };
  }

  document.addEventListener('astro:page-load', () => {
    setupMobileMenu();
    setupReadingProgress();
  });

  document.addEventListener('astro:before-swap', () => {
    if (activeReadingScrollListener) {
      window.removeEventListener('scroll', activeReadingScrollListener);
      window.removeEventListener('resize', activeReadingScrollListener);
      activeReadingScrollListener = null;
    }
  });
</script>
