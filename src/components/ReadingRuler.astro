---
// ReadingRuler.astro: Régua Horizontal de Leitura Fixada Logo Abaixo do Header
---

<div
  id="reading-ruler-container"
  aria-hidden="true"
  class="sticky top-[57px] sm:top-[68px] md:top-[93px] z-30 w-full bg-canvas/80 backdrop-blur-xs border-b border-border-brutal/20 select-none pointer-events-none"
>
  <div class="w-full h-1 bg-border-brutal/20 relative">
    <!-- Barra Vermelha de Progresso -->
    <div
      id="reading-ruler-progress"
      class="h-full bg-manifesto-red transition-all duration-75 relative"
      style="width: 0%;"
    >
      <!-- Indicador Numérico Monospaçado de Precisão -->
      <span
        id="reading-ruler-pct"
        class="absolute top-1 right-0 translate-x-1/2 font-mono text-[9px] font-bold text-white bg-manifesto-red px-1 py-0.2 border border-border-brutal shadow-xs"
      >
        [00%]
      </span>
    </div>
  </div>
</div>

<script>
  let activeScrollListener: (() => void) | null = null;

  function setupReadingRuler() {
    if (activeScrollListener) {
      window.removeEventListener('scroll', activeScrollListener);
      activeScrollListener = null;
    }

    const progressEl = document.getElementById('reading-ruler-progress');
    const pctEl = document.getElementById('reading-ruler-pct');

    if (!progressEl || !pctEl) return;

    activeScrollListener = () => {
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      if (docHeight <= 0) return;

      const scrollTop = window.scrollY || document.documentElement.scrollTop;
      const progress = Math.min(100, Math.max(0, (scrollTop / docHeight) * 100));

      progressEl.style.width = `${progress}%`;
      pctEl.textContent = `[${Math.round(progress).toString().padStart(2, '0')}%]`;
    };

    window.addEventListener('scroll', activeScrollListener, { passive: true });
    activeScrollListener();
  }

  document.addEventListener('astro:page-load', setupReadingRuler);
  document.addEventListener('astro:before-swap', () => {
    if (activeScrollListener) {
      window.removeEventListener('scroll', activeScrollListener);
      activeScrollListener = null;
    }
  });
</script>
