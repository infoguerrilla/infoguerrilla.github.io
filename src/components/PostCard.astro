---
// PostCard.astro: Card Construtivista de Ensaio com 3D Tilt
import type { CollectionEntry } from 'astro:content';
import { formatPostDate, calculateReadingTime, normalizeSlug } from '../utils/posts';

interface Props {
  post: CollectionEntry<'post'>;
}

const { post } = Astro.props;
const formattedDate = formatPostDate(post.data.date);
const readingMinutes = calculateReadingTime(post.body || '');
const postSlug = post.data.slug ? normalizeSlug(post.data.slug) : normalizeSlug(post.slug);
const primaryCategory = post.data.categories?.[0] || 'ENSAIO';
---

<article class="perspective-1000 h-full">
  <div
    data-tilt
    class="preserve-3d group relative flex flex-col justify-between h-full border-2 border-border-brutal bg-surface p-5 sm:p-6 transition-all duration-150 shadow-constructivist-md hover:shadow-constructivist-double hover:border-manifesto-red cut-corner-br"
  >
    <!-- Camada Superior com Categoria e Data -->
    <div>
      <div class="flex items-center justify-between gap-2 mb-4">
        <!-- Badge Construtivista de Categoria (translateZ para relevo 3D) -->
        <span class="inline-block bg-manifesto-red text-white font-mono text-[11px] font-bold px-2.5 py-0.5 uppercase tracking-wider shadow-sm transform-gpu group-hover:translate-z-4">
          // {primaryCategory}
        </span>
        
        <!-- Data Datilografada -->
        <time datetime={post.data.date.toISOString()} class="font-mono text-xs text-ink-muted">
          {formattedDate}
        </time>
      </div>

      <!-- Título Monumental -->
      <h3 class="font-display font-extrabold text-xl sm:text-2xl leading-tight text-ink mb-3 group-hover:text-manifesto-red transition-colors">
        <a href={`/post/${postSlug}`} class="block focus:outline-none">
          {post.data.title}
        </a>
      </h3>

      <!-- Resumo Editorial Acadêmico -->
      {post.data.description && (
        <p class="font-serif text-sm text-ink-muted line-clamp-3 mb-4 leading-relaxed">
          {post.data.description}
        </p>
      )}
    </div>

    <!-- Rodapé do Card com Tempo de Leitura e Ação -->
    <div class="pt-4 border-t border-border-brutal/20 flex items-center justify-between font-mono text-xs">
      <span class="text-ink-muted">
        [{readingMinutes} MIN LEITURA]
      </span>

      <a
        href={`/post/${postSlug}`}
        class="inline-flex items-center gap-1 font-bold text-ink group-hover:text-manifesto-red group-hover:translate-x-1 transition-all"
      >
        <span>LER_ENSAIO</span>
        <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </div>
</article>

