---
// PostCard.astro: Card Construtivista de Ensaio com 3D Tilt e Imagem de Época
import type { CollectionEntry } from 'astro:content';
import { formatPostDate, calculateReadingTime, normalizeSlug } from '../utils/posts';
import { getPostFeaturedImage } from '../utils/images';
import { getAuthorSlug } from '../data/authors';
import { getSeriesName } from '../utils/series';

interface Props {
  post: CollectionEntry<'post'>;
}

const { post } = Astro.props;
const formattedDate = formatPostDate(post.data.date);
const readingMinutes = calculateReadingTime(post.body || '');
const postSlug = post.data.slug ? normalizeSlug(post.data.slug) : normalizeSlug(post.slug);
const authorSlug = getAuthorSlug(post.data.author);
const seriesName = getSeriesName(post.data.series);
const primaryTag = post.data.tags?.[0] || 'PUBLICAÇÃO';
const featuredImg = getPostFeaturedImage(post.id, post.data.image);
---

<article class="perspective-1000 h-full">
  <div
    data-tilt
    class="preserve-3d group relative flex flex-col justify-between h-full border-2 border-border-brutal bg-surface p-5 transition-all duration-150 shadow-constructivist-md hover:shadow-constructivist-double hover:border-manifesto-red cut-corner-br"
  >
    <!-- Camada Superior com Imagem, Série/Tag e Data -->
    <div>
      <div class="flex items-center justify-between gap-2 mb-3">
        <!-- Badge Construtivista de Série ou Tag -->
        {seriesName ? (
          <span class="inline-block bg-manifesto-red text-white font-mono text-[11px] font-black px-2 py-0.5 uppercase tracking-wider shadow-xs">
            // SÉRIE: {seriesName}
          </span>
        ) : (
          <span class="inline-block bg-border-brutal text-canvas dark:bg-canvas dark:text-ink font-mono text-[11px] font-bold px-2 py-0.5 uppercase tracking-wider shadow-xs">
            // #{primaryTag}
          </span>
        )}
        
        <!-- Data Datilografada -->
        <time datetime={post.data.date.toISOString()} class="font-mono text-xs text-ink-muted">
          {formattedDate}
        </time>
      </div>

      <!-- Imagem de Destaque Estilo Arquivo de Época (se houver) -->
      {featuredImg && (
        <a href={`/post/${postSlug}`} class="block mb-4 overflow-hidden">
          <img
            src={featuredImg}
            alt={`Capa de ${post.data.title}`}
            class="vintage-archive-img w-full h-40 object-cover"
            loading="lazy"
          />
        </a>
      )}

      <!-- Título Monumental -->
      <h3 class="font-display font-extrabold text-lg sm:text-xl leading-tight text-ink mb-2 group-hover:text-manifesto-red transition-colors">
        <a href={`/post/${postSlug}`} class="block focus:outline-none">
          {post.data.title}
        </a>
      </h3>

      <!-- Resumo Editorial Acadêmico -->
      {post.data.description && (
        <p class="font-serif text-xs sm:text-sm text-ink-muted line-clamp-2 mb-4 leading-relaxed">
          {post.data.description}
        </p>
      )}
    </div>

    <!-- Rodapé do Card com Autor, Tempo de Leitura e Ação -->
    <div class="pt-3 border-t border-border-brutal/20 flex items-center justify-between font-mono text-xs">
      <div>
        <a
          href={`/autor/${authorSlug}`}
          class="text-ink-muted hover:text-manifesto-red hover:underline text-[11px]"
        >
          {post.data.author}
        </a>
      </div>

      <div class="flex items-center gap-3">
        <span class="text-ink-muted text-[11px]">[{readingMinutes}m]</span>
        <a
          href={`/post/${postSlug}`}
          class="font-bold text-ink group-hover:text-manifesto-red transition-colors"
          aria-label={`Ler ${post.data.title}`}
        >
          &rarr;
        </a>
      </div>
    </div>
  </div>
</article>
