---
// index.astro: Capa Construtivista do Info_Guerrilla
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroPoster from '../components/HeroPoster.astro';
import PostCard from '../components/PostCard.astro';
import Marquee from '../components/Marquee.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('post');
const sortedPosts = allPosts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const featuredPost = sortedPosts[0];
const secondaryPosts = sortedPosts.slice(1);

// Coletar tags únicas e suas contagens
const tagsMap = new Map<string, number>();
allPosts.forEach((p) => {
  p.data.tags?.forEach((tag) => {
    const normalized = tag.toLowerCase().trim();
    if (normalized) {
      tagsMap.set(normalized, (tagsMap.get(normalized) || 0) + 1);
    }
  });
});
const popularTags = Array.from(tagsMap.entries()).sort(
  (a, b) => b[1] - a[1] || a[0].localeCompare(b[0])
);
---

<BaseLayout
  title="Info_Guerrilla // Teoria Crítica, Política & Tecnologia"
  description="Publicação editorial e acadêmica crítica. Para que o trabalho do alfaiate não desapareça na roupa."
>
  <!-- Destaque Monumental / Hero Poster -->
  {featuredPost && <HeroPoster post={featuredPost} />}

  <!-- Fita Cinética Construtivista -->
  <div class="my-10">
    <Marquee />
  </div>

  <!-- Cabeçalho da Seção de Ensaios -->
  <section class="mt-12 mb-8">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between border-b-2 border-border-brutal pb-3 mb-8 gap-2">
      <div>
        <span class="font-mono text-xs font-bold text-manifesto-red uppercase tracking-widest block mb-1">
          // ACERVO_RECENTE
        </span>
        <h2 class="font-display font-extrabold text-2xl sm:text-3xl md:text-4xl uppercase tracking-tight sm:tracking-wide text-ink">
          PUBLICAÇÕES
        </h2>
      </div>

      <div class="font-mono text-xs text-ink-muted">
        TOTAL NO ACERVO: <strong class="text-manifesto-red font-bold">{allPosts.length}</strong> PUBLICAÇÕES
      </div>
    </div>

    <!-- Grade de Ensaios (3D Tilt Cards) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {secondaryPosts.map((post) => (
        <PostCard post={post} />
      ))}
    </div>
  </section>

  <!-- Painel de Tags e Temas em Destaque / Construtivista -->
  <section class="mt-16 border-2 border-border-brutal bg-surface p-4 sm:p-6 md:p-8 cut-corner-br shadow-constructivist-md">
    <div class="border-b border-border-brutal/30 pb-3 mb-6 flex flex-wrap items-center justify-between gap-2">
      <h3 class="font-display font-extrabold text-xl sm:text-2xl uppercase tracking-tight sm:tracking-wide text-ink">
        TAGS
      </h3>
      <span class="font-mono text-xs text-manifesto-red font-bold">[{popularTags.length} TAGS_ATIVAS]</span>
    </div>

    <div class="flex flex-wrap gap-2.5" id="index-tags-container">
      {popularTags.map(([tag, count], index) => (
        <a
          href={`/arquivo?tag=${encodeURIComponent(tag)}`}
          class={`index-tag-item press-btn inline-flex items-center gap-2 border border-border-brutal bg-canvas px-3 py-1.5 font-mono text-xs text-ink hover:border-manifesto-red hover:bg-manifesto-red hover:text-white transition-all shadow-constructivist-sm ${
            index >= 20 ? 'hidden index-extra-tag' : ''
          }`}
        >
          <span class="font-bold">#{tag}</span>
          <span class="bg-manifesto-red text-white text-[10px] px-1.5 py-0.2 rounded-none font-bold">
            {count}
          </span>
        </a>
      ))}
      {popularTags.length > 20 && (
        <button
          type="button"
          id="expand-index-tags-btn"
          data-expanded="false"
          class="press-btn border-2 border-manifesto-red bg-manifesto-red/10 text-manifesto-red hover:bg-manifesto-red hover:text-white px-3 py-1.5 font-mono text-xs font-bold uppercase transition-all shadow-constructivist-sm"
        >
          [+ VER MAIS TAGS ({popularTags.length - 20})]
        </button>
      )}
    </div>
  </section>

  <script>
    function setupIndexTagsExpand() {
      const btn = document.getElementById('expand-index-tags-btn');
      const extraTags = document.querySelectorAll<HTMLElement>('.index-extra-tag');
      if (!btn || extraTags.length === 0) return;

      btn.addEventListener('click', () => {
        const isExpanded = btn.getAttribute('data-expanded') === 'true';
        if (isExpanded) {
          extraTags.forEach((t) => t.classList.add('hidden'));
          btn.setAttribute('data-expanded', 'false');
          btn.textContent = `[+ VER MAIS TAGS (${extraTags.length})]`;
        } else {
          extraTags.forEach((t) => t.classList.remove('hidden'));
          btn.setAttribute('data-expanded', 'true');
          btn.textContent = '[- RECOLHER TAGS]';
        }
      });
    }

    document.addEventListener('astro:page-load', setupIndexTagsExpand);
  </script>
</BaseLayout>

