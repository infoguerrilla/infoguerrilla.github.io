---
// busca.astro: Terminal de Pesquisa Construtivista integrado ao Pagefind
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { formatPostDate, normalizeSlug } from '../utils/posts';
import { getSeriesName } from '../utils/series';

const allPosts = await getCollection('post');
const fallbackIndex = allPosts.map((p) => ({
  title: p.data.title,
  description: p.data.description || '',
  slug: p.data.slug ? normalizeSlug(p.data.slug) : normalizeSlug(p.slug),
  date: formatPostDate(p.data.date),
  series: getSeriesName(p.data.series) || '',
  tags: p.data.tags || [],
}));
---

<BaseLayout
  title="Busca no Acervo // Info_Guerrilla"
  description="Pesquise por termos, conceitos, autores, séries e tags no acervo do Info_Guerrilla."
>
  <div class="max-w-4xl mx-auto">
    
    <!-- Cabeçalho de Busca -->
    <header class="border-b-2 border-border-brutal pb-6 mb-8">
      <div class="flex items-center gap-2 font-mono text-xs text-manifesto-red font-bold uppercase mb-2">
        <span class="inline-block w-3 h-3 bg-manifesto-red"></span>
        // TERMINAL_DE_INDEXAÇÃO_PAGEFIND
      </div>
      <h1 class="font-display font-black text-3xl sm:text-4xl md:text-5xl uppercase tracking-tight text-ink mb-4">
        PESQUISAR NO ACERVO
      </h1>
      <p class="font-serif italic text-base text-ink-muted">
        Indexação completa das publicações, palavras-chave e debates teóricos.
      </p>
    </header>

    <!-- Campo de Busca Estilo Terminal -->
    <div class="border-2 border-border-brutal bg-surface p-6 shadow-constructivist-md cut-corner-br mb-8">
      <label for="search-input" class="block font-mono text-xs font-bold uppercase tracking-wider text-ink mb-2">
        &gt; DIGITE O TERMO DE PESQUISA:
      </label>
      <div class="relative">
        <input
          type="text"
          id="search-input"
          placeholder="Pesquisar..."
          data-desktop-placeholder="ex: software livre, mark fisher, vigilância, capitalismo..."
          class="w-full border-2 border-border-brutal bg-canvas pl-4 pr-20 sm:pr-24 py-3 font-mono text-sm sm:text-base text-ink placeholder:text-ink-muted/50 focus:border-manifesto-red focus:outline-none shadow-constructivist-sm"
          autofocus
        />
        <button
          id="clear-search"
          type="button"
          class="absolute right-3 top-1/2 -translate-y-1/2 font-mono text-xs text-ink-muted hover:text-manifesto-red uppercase font-bold"
        >
          [LIMPAR]
        </button>
      </div>

      <div class="flex items-center justify-between mt-3 font-mono text-xs text-ink-muted">
        <span id="results-count">DIGITE PARA PESQUISAR NO ACERVO</span>
        <span id="search-engine-badge">MOTOR: PAGEFIND ESTÁTICO</span>
      </div>
    </div>

    <!-- Lista de Resultados -->
    <div id="results-container" class="space-y-4">
      <!-- Inserido dinamicamente pelo script -->
    </div>
  </div>

  <!-- Fallback serializado para ambiente de desenvolvimento -->
  <script is:inline define:vars={{ fallbackIndex }}>
    window.__FALLBACK_SEARCH_INDEX__ = fallbackIndex;
  </script>

  <script>
    async function setupSearch() {
      const input = document.getElementById('search-input') as HTMLInputElement | null;
      const clearBtn = document.getElementById('clear-search');
      const countEl = document.getElementById('results-count');
      const container = document.getElementById('results-container');
      const badge = document.getElementById('search-engine-badge');

      if (!input || !container || !countEl) return;

      let pagefindInstance: any = null;

      try {
        // Tenta carregar dinamicamente o Pagefind estático no browser (gerado pós-build)
        const loadPagefind = new Function('url', 'return import(url)');
        pagefindInstance = await loadPagefind('/pagefind/pagefind.js');
        await pagefindInstance.init();
        if (badge) badge.textContent = 'MOTOR: PAGEFIND (TEXTO COMPLETO)';
      } catch (e) {
        if (badge) badge.textContent = 'MOTOR: METADADOS (MODO DEV)';
      }

      async function executeSearch(query: string) {
        const cleanQuery = query.trim();

        if (!cleanQuery) {
          container!.innerHTML = '';
          countEl!.textContent = 'DIGITE PARA PESQUISAR NO ACERVO';
          return;
        }

        if (pagefindInstance) {
          const search = await pagefindInstance.search(cleanQuery);
          const results = await Promise.all(search.results.slice(0, 15).map((r: any) => r.data()));

          countEl!.textContent = `[${results.length}] RESULTADO(S) ENCONTRADO(S)`;

          if (results.length === 0) {
            container!.innerHTML = `
              <div class="border-2 border-dashed border-border-brutal p-8 text-center bg-surface font-mono text-sm text-ink-muted">
                NENHUMA PUBLICAÇÃO ENCONTRADA PARA O TERMO "${query}".
              </div>
            `;
            return;
          }

          container!.innerHTML = results
            .map(
              (item: any) => `
            <article class="border-2 border-border-brutal bg-surface p-5 hover:border-manifesto-red shadow-constructivist-sm transition-all cut-corner-br">
              <div class="font-mono text-xs text-manifesto-red font-bold mb-1">
                // ${item.meta.title || 'PUBLICAÇÃO'}
              </div>
              <h3 class="font-display font-black text-xl text-ink hover:text-manifesto-red mb-2">
                <a href="${item.url}">${item.meta.title || item.url}</a>
              </h3>
              <p class="font-serif text-sm text-ink-muted line-clamp-3 leading-relaxed [&_mark]:bg-manifesto-red [&_mark]:text-white [&_mark]:px-1">
                ${item.excerpt}
              </p>
            </article>
          `
            )
            .join('');
        } else {
          // Fallback para dev server
          const index = (window as any).__FALLBACK_SEARCH_INDEX__ || [];
          const lower = cleanQuery.toLowerCase();
          const matches = index.filter((item: any) => {
            return (
              item.title.toLowerCase().includes(lower) ||
              item.description.toLowerCase().includes(lower) ||
              (item.series && item.series.toLowerCase().includes(lower)) ||
              (item.tags && item.tags.some((t: string) => t.toLowerCase().includes(lower)))
            );
          });

          countEl!.textContent = `[${matches.length}] RESULTADO(S) ENCONTRADO(S)`;

          if (matches.length === 0) {
            container!.innerHTML = `
              <div class="border-2 border-dashed border-border-brutal p-8 text-center bg-surface font-mono text-sm text-ink-muted">
                NENHUMA PUBLICAÇÃO ENCONTRADA PARA O TERMO "${query}".
              </div>
            `;
            return;
          }

          container!.innerHTML = matches
            .map(
              (item: any) => `
            <article class="border-2 border-border-brutal bg-surface p-5 hover:border-manifesto-red shadow-constructivist-sm transition-all cut-corner-br">
              <div class="font-mono text-xs text-manifesto-red font-bold mb-1">
                // ${item.date}
              </div>
              <h3 class="font-display font-black text-xl text-ink hover:text-manifesto-red mb-2">
                <a href="/post/${item.slug}">${item.title}</a>
              </h3>
              ${item.description ? `<p class="font-serif text-sm text-ink-muted line-clamp-2">${item.description}</p>` : ''}
            </article>
          `
            )
            .join('');
        }
      }

      function updatePlaceholder() {
        if (!input) return;
        if (window.matchMedia('(min-width: 640px)').matches) {
          input.placeholder = input.dataset.desktopPlaceholder || 'ex: software livre, mark fisher, vigilância, capitalismo...';
        } else {
          input.placeholder = 'Pesquisar...';
        }
      }

      updatePlaceholder();
      window.addEventListener('resize', updatePlaceholder, { passive: true });

      input.addEventListener('input', () => {
        executeSearch(input.value);
      });

      clearBtn?.addEventListener('click', () => {
        input.value = '';
        executeSearch('');
        input.focus();
      });
    }

    document.addEventListener('astro:page-load', setupSearch);
  </script>
</BaseLayout>
