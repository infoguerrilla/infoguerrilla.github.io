---
// busca.astro: Terminal de Pesquisa Instantânea no Acervo
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { formatPostDate, normalizeSlug } from '../utils/posts';

const allPosts = await getCollection('post');
const searchIndex = allPosts.map((p) => ({
  title: p.data.title,
  description: p.data.description || '',
  slug: p.data.slug ? normalizeSlug(p.data.slug) : normalizeSlug(p.slug),
  date: formatPostDate(p.data.date),
  categories: p.data.categories || [],
  tags: p.data.tags || [],
}));
---

<BaseLayout
  title="Busca no Acervo // Info_Guerrilla"
  description="Pesquise por termos, conceitos, autores e categorias no acervo do Info_Guerrilla."
>
  <div class="max-w-4xl mx-auto">
    
    <!-- Cabeçalho de Busca -->
    <header class="border-b-2 border-border-brutal pb-6 mb-8">
      <div class="flex items-center gap-2 font-mono text-xs text-manifesto-red font-bold uppercase mb-2">
        <span class="inline-block w-3 h-3 bg-manifesto-red"></span>
        // TERMINAL_DE_INDEXAÇÃO
      </div>
      <h1 class="font-display font-black text-3xl sm:text-4xl md:text-5xl uppercase tracking-tight text-ink mb-4">
        PESQUISAR NO ACERVO
      </h1>
      <p class="font-serif italic text-base text-ink-muted">
        Localize artigos, palavras-chave e debates teóricos publicados no blog.
      </p>
    </header>

    <!-- Campo de Busca Estilo Terminal -->
    <div class="border-2 border-border-brutal bg-surface p-6 shadow-constructivist-md cut-corner-br mb-8">
      <label for="search-input" class="block font-mono text-xs font-bold uppercase tracking-wider text-ink mb-2">
        &gt; DIGITE O TERMO DE PESQUISA:
      </label>
      <div class="relative">
        <input
          type="text"
          id="search-input"
          placeholder="ex: software livre, mark fisher, vigilância, capitalismo..."
          class="w-full border-2 border-border-brutal bg-canvas px-4 py-3 font-mono text-sm sm:text-base text-ink placeholder:text-ink-muted/50 focus:border-manifesto-red focus:outline-none shadow-constructivist-sm"
          autofocus
        />
        <button
          id="clear-search"
          type="button"
          class="absolute right-3 top-1/2 -translate-y-1/2 font-mono text-xs text-ink-muted hover:text-manifesto-red uppercase font-bold"
        >
          [LIMPAR]
        </button>
      </div>

      <div class="flex items-center justify-between mt-3 font-mono text-xs text-ink-muted">
        <span id="results-count">DIGITE PARA PESQUISAR NO ACERVO</span>
        <span>INDEXAÇÃO INSTANTÂNEA</span>
      </div>
    </div>

    <!-- Lista de Resultados -->
    <div id="results-container" class="space-y-4">
      <!-- Inserido dinamicamente pelo script -->
    </div>
  </div>

  <!-- Dados serializados para busca em tempo real -->
  <script is:inline define:vars={{ searchIndex }}>
    window.__SEARCH_INDEX__ = searchIndex;
  </script>

  <script>
    function setupSearch() {
      const input = document.getElementById('search-input') as HTMLInputElement | null;
      const clearBtn = document.getElementById('clear-search');
      const countEl = document.getElementById('results-count');
      const container = document.getElementById('results-container');
      const index = (window as any).__SEARCH_INDEX__ || [];

      if (!input || !container || !countEl) return;

      function renderResults(query: string) {
        const cleanQuery = query.trim().toLowerCase();
        
        if (!cleanQuery) {
          container.innerHTML = '';
          countEl.textContent = 'DIGITE PARA PESQUISAR NO ACERVO';
          return;
        }

        const matches = index.filter((item: any) => {
          const inTitle = item.title.toLowerCase().includes(cleanQuery);
          const inDesc = item.description.toLowerCase().includes(cleanQuery);
          const inCats = item.categories.some((c: string) => c.toLowerCase().includes(cleanQuery));
          const inTags = item.tags.some((t: string) => t.toLowerCase().includes(cleanQuery));
          return inTitle || inDesc || inCats || inTags;
        });

        countEl.textContent = `[${matches.length}] RESULTADO(S) ENCONTRADO(S)`;

        if (matches.length === 0) {
          container.innerHTML = `
            <div class="border-2 border-dashed border-border-brutal p-8 text-center bg-surface font-mono text-sm text-ink-muted">
              NENHUM ENSAIO ENCONTRADO PARA O TERMO "${query}".
            </div>
          `;
          return;
        }

        container.innerHTML = matches
          .map(
            (item: any) => `
          <article class="border-2 border-border-brutal bg-surface p-5 hover:border-manifesto-red shadow-constructivist-sm transition-all cut-corner-br">
            <div class="flex items-center justify-between font-mono text-xs text-ink-muted mb-2">
              <span class="text-manifesto-red font-bold">${item.date}</span>
              <div class="flex gap-1">
                ${item.categories.map((c: string) => `<span class="bg-canvas border border-border-brutal/20 px-1.5 py-0.2">#${c}</span>`).join('')}
              </div>
            </div>
            <h3 class="font-display font-black text-xl text-ink hover:text-manifesto-red mb-2">
              <a href="/post/${item.slug}">${item.title}</a>
            </h3>
            ${item.description ? `<p class="font-serif text-sm text-ink-muted line-clamp-2">${item.description}</p>` : ''}
          </article>
        `
          )
          .join('');
      }

      input.addEventListener('input', () => {
        renderResults(input.value);
      });

      clearBtn?.addEventListener('click', () => {
        input.value = '';
        renderResults('');
        input.focus();
      });
    }

    setupSearch();
    document.addEventListener('astro:page-load', setupSearch);
  </script>
</BaseLayout>
