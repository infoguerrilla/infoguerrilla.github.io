---
// [...slug].astro: Página de Leitura do Ensaio (Editorial Acadêmico)
import BaseLayout from '../../layouts/BaseLayout.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import SeriesBox from '../../components/SeriesBox.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { formatPostDate, calculateReadingTime, normalizeSlug } from '../../utils/posts';
import { getPostFeaturedImage } from '../../utils/images';
import { getAuthorSlug } from '../../data/authors';
import { getSeriesNavigation } from '../../utils/series';

export async function getStaticPaths() {
  const posts = await getCollection('post');
  const sorted = posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

  const paths: Array<{ params: { slug: string }; props: { post: CollectionEntry<'post'>; prevPost?: CollectionEntry<'post'>; nextPost?: CollectionEntry<'post'>; allPosts: CollectionEntry<'post'>[] } }> = [];

  sorted.forEach((post, index) => {
    const prevPost = index < sorted.length - 1 ? sorted[index + 1] : undefined;
    const nextPost = index > 0 ? sorted[index - 1] : undefined;

    const folderSlug = post.id.replace(/\/index\.md$/, '');
    const rawSlug = post.slug;
    const normalizedSlug = normalizeSlug(post.slug);
    const normalizedFolder = normalizeSlug(folderSlug);

    const slugSet = new Set([normalizedSlug, rawSlug, folderSlug, normalizedFolder]);

    for (const slug of slugSet) {
      if (slug) {
        paths.push({
          params: { slug },
          props: { post, prevPost, nextPost, allPosts: posts },
        });
      }
    }
  });

  return paths;
}

interface Props {
  post: CollectionEntry<'post'>;
  prevPost?: CollectionEntry<'post'>;
  nextPost?: CollectionEntry<'post'>;
  allPosts?: CollectionEntry<'post'>[];
}

const { post, prevPost, nextPost, allPosts = [] } = Astro.props;
const { Content, headings } = await post.render();

const formattedDate = formatPostDate(post.data.date);
const readingMinutes = calculateReadingTime(post.body || '');
const authorSlug = getAuthorSlug(post.data.author);
const featuredImg = getPostFeaturedImage(post.id, post.data.image);
const seriesNav = allPosts.length > 0 ? getSeriesNavigation(post, allPosts) : null;

const prevSlug = prevPost ? normalizeSlug(prevPost.slug) : null;
const nextSlug = nextPost ? normalizeSlug(nextPost.slug) : null;
---

<BaseLayout
  title={`${post.data.title} // Info_Guerrilla`}
  description={post.data.description || "Ensaio acadêmico e editorial crítico."}
  image={featuredImg || "/favicon.png"}
>
  <!-- data-pagefind-body garante que apenas o conteúdo do artigo é indexado pelo Pagefind -->
  <article data-pagefind-body class="max-w-5xl mx-auto pt-4">
    
    <!-- Cabeçalho do Ensaio / Cartaz Editorial -->
    <header class="border-b-2 border-border-brutal pb-8 mb-10">
      
      <!-- Navegação Superior / Breadcrumb -->
      <nav class="font-mono text-xs text-ink-muted mb-6 flex flex-wrap items-center gap-2" aria-label="Navegação">
        <a href="/" class="hover:text-manifesto-red hover:underline">[INÍCIO]</a>
        <span>/</span>
        <a href="/arquivo" class="hover:text-manifesto-red hover:underline">[ARQUIVO]</a>
        <span>/</span>
        <span class="text-manifesto-red font-bold">{formattedDate}</span>
      </nav>

      <!-- Tags em Carimbo Construtivista -->
      <div class="flex flex-wrap gap-2 mb-4">
        {post.data.tags?.map((tag) => (
          <a
            href={`/arquivo?tag=${encodeURIComponent(tag.toLowerCase())}`}
            class="bg-manifesto-red text-white font-mono text-xs font-bold px-2.5 py-0.5 uppercase tracking-wider shadow-constructivist-sm hover:opacity-90 transition-opacity"
          >
            // #{tag}
          </a>
        ))}
      </div>

      <!-- Título Monumental -->
      <h1 class="font-display font-black text-3xl sm:text-4xl md:text-5xl text-ink uppercase tracking-tight leading-[1.12] mb-6">
        {post.data.title}
      </h1>

      <!-- Resumo de Entrada / Epígrafe -->
      {post.data.description && (
        <p class="font-serif italic text-lg sm:text-xl text-ink leading-relaxed border-l-4 border-manifesto-red pl-4 my-6 bg-surface p-4">
          {post.data.description}
        </p>
      )}

      <!-- Imagem de Destaque com Estética de Arquivo Histórico de Época e Legenda Editorial -->
      {featuredImg && (
        <figure class="my-8">
          <img
            src={featuredImg}
            alt={post.data.imageCaption || post.data.caption || `Imagem de destaque para ${post.data.title}`}
            class="vintage-archive-img w-full max-h-[500px] object-cover"
          />
          {(post.data.imageCaption || post.data.caption) && (
            <figcaption class="mt-2.5 font-mono text-xs text-ink-muted text-center tracking-tight border-b border-border-brutal/20 pb-2">
              <span class="text-manifesto-red font-bold mr-1">// FIG:</span>
              {post.data.imageCaption || post.data.caption}
            </figcaption>
          )}
        </figure>
      )}

      <!-- Metadados de Autoria (com link para a página do autor) e Leitura -->
      <div class="flex flex-wrap items-center justify-between gap-4 font-mono text-xs text-ink-muted pt-4 border-t border-border-brutal/20">
        <div>
          AUTORIA: 
          <a
            href={`/autor/${authorSlug}`}
            class="font-bold text-ink hover:text-manifesto-red hover:underline ml-1"
          >
            {post.data.author} &rarr;
          </a>
        </div>
        <div>
          TEMPO DE LEITURA: <strong class="text-manifesto-red">[{readingMinutes} MIN]</strong>
        </div>
      </div>
    </header>

    <!-- Caixa de Navegação da Série (se o post pertencer a uma) -->
    {seriesNav && (
      <SeriesBox nav={seriesNav} />
    )}

    <!-- Sumário Retrátil para Telas Menores -->
    <div class="lg:hidden">
      <TableOfContents headings={headings} />
    </div>

    <!-- Layout de Duas Colunas: Texto do Ensaio + Sumário Sticky à Direita -->
    <div class="lg:flex lg:gap-12 lg:items-start">
      
      <!-- Corpo do Artigo: Leitura Acadêmica Newsreader -->
      <div class="academic-prose flex-grow max-w-none lg:max-w-[700px]">
        <Content />
      </div>

      <!-- Sumário Sticky Acompanhando a Leitura à Direita em Desktop -->
      {headings.length > 0 && (
        <aside class="hidden lg:block w-72 shrink-0 sticky top-28 self-start">
          <TableOfContents headings={headings} />
        </aside>
      )}
    </div>

    <!-- Rodapé do Ensaio (Sem a caixa de "Como citar") -->
    <footer class="mt-16 pt-8 border-t-2 border-border-brutal space-y-8" data-pagefind-ignore>
      {seriesNav && (
        <SeriesBox nav={seriesNav} isFooter={true} />
      )}
      
      <!-- Navegação Entre Ensaios (Anterior / Próximo) -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 font-mono text-xs">
        {prevPost && prevSlug ? (
          <a
            href={`/post/${prevSlug}`}
            class="press-btn border-2 border-border-brutal bg-surface p-4 flex flex-col justify-between hover:border-manifesto-red shadow-constructivist-sm"
          >
            <span class="text-ink-muted mb-1">&larr; ENSAIO ANTERIOR</span>
            <span class="font-display font-bold text-sm text-ink line-clamp-2">
              {prevPost.data.title}
            </span>
          </a>
        ) : <div />}

        {nextPost && nextSlug ? (
          <a
            href={`/post/${nextSlug}`}
            class="press-btn border-2 border-border-brutal bg-surface p-4 flex flex-col justify-between text-right hover:border-manifesto-red shadow-constructivist-sm"
          >
            <span class="text-ink-muted mb-1">PRÓXIMO ENSAIO &rarr;</span>
            <span class="font-display font-bold text-sm text-ink line-clamp-2">
              {nextPost.data.title}
            </span>
          </a>
        ) : <div />}
      </div>
    </footer>
  </article>
</BaseLayout>
